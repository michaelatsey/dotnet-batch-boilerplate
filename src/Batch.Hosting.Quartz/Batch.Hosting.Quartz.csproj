<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Adaptateur Quartz.NET 4 : déclenche les jobs batch depuis des triggers cron, en mémoire ou en cluster PostgreSQL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Batch.Core/Batch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Quartz ne référence pas le pilote ADO.NET : il doit être fourni par l'application. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
