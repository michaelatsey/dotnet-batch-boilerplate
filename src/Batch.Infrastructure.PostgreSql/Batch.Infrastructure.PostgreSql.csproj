  <ItemGroup>
    <EmbeddedResource Include="Sql/001_batch_journal.sql" LogicalName="batch-journal.sql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Batch.IntegrationTests" />
  </ItemGroup>
</Project>
