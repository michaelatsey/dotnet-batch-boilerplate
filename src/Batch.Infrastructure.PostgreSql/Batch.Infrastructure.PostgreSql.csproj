<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Journal d'exécution (EF Core 10) et verrou distribué (advisory lock) sur PostgreSQL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Batch.Core/Batch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="DistributedLock.Postgres" />
