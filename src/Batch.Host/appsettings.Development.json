{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information"
    }
  },
  "ConnectionStrings": {
    "Batch": "Host=localhost;Port=5432;Database=batch;Username=batch;Password=batch"
  },
  "Batch": {
    "HeartbeatInterval": "00:00:05",
    "Quartz": {
      "Store": "Postgres",
      "ProvisionSchema": true
    },
    "Schedules": {
      "import-invoices-every-minute": {
        "Job": "import-invoices",
        "Cron": "0 * * * * ?",
        "TimeZone": "Europe/Paris",
        "Parameters": { "InputFile": "samples/invoices.csv" }
      }
    }
  }
}
