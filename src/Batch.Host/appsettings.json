{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Quartz": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "LogToStandardErrorThreshold": "Trace",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },

  "ConnectionStrings": {
    "Batch": ""
  },

  "Batch": {
    "ServiceName": "batch-host",
    "HeartbeatInterval": "00:00:30",
    "FinalizationTimeout": "00:00:15",
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelay": "00:00:01",
      "MaxDelay": "00:00:30"
    },

    "Jobs": {
      "import-invoices": {
        "ChunkSize": 1000,
        "SkipLimit": 100
      }
    },

    "Quartz": {
      "Store": "Memory",
      "ConnectionStringName": "Batch",
      "ProvisionSchema": false,
      "MaxConcurrency": 4
    },

    "Schedules": {
      "purge-executions-nightly": {
        "Job": "purge-executions",
        "Cron": "0 15 3 * * ?",
        "TimeZone": "Europe/Paris",
        "Parameters": { "RetentionDays": "90" }
      }
    }
  }
}
